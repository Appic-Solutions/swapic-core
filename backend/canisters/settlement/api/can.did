// Why an event was not appended. Nothing was written.
type AppendError = variant {
  ChainDiverged : record { log_head : blob; state_head : blob };
  LogFull;
  Transition : TransitionError;
  IndexMismatch : record { sealed : nat64; log_len : nat64 };
  Canonical : CanonicalError;
  OutOfStableMemory : record { current_pages : nat64; delta_pages : nat64 };
};
// What one step of the deep check found.
// 
// `finished` is the field to read first: only a step that reached the head compared the
// fold with the live one, and `matches` is its verdict. A step short of the head reports
// how far the fold got and how much is left, and condemns nothing. An entry the fold
// refuses, or a finished fold that differs, is a divergence and halts the canister; every
// verdict starts the next audit over from genesis.
type AuditProgress = record {
  // whether the fold is the live fold, which only a finished step says
  matches : bool;
  finished : bool;
  // whether this step halted the canister
  halted : bool;
  // entries between the fold and the head, as the log stood when this step read it
  remaining : nat64;
  // entries folded from genesis, this step's included
  folded_so_far : nat64;
  // why the fold stopped, if it did
  refused : opt ReplayError;
};
// A value the canonical preimage has no bytes for.
type CanonicalError = variant {
  TooLong : record { len : nat64 };
  AmountTooLarge : nat;
};
// One chain as the watcher last saw it. There is no instant on it: the canister stamps
// what it receives, so nothing a caller sends can date its data forward.
type ChainData = record {
  // The base fee of that block.
  base_fee_wei_per_gas : nat;
  // The head block the watcher saw.
  block : nat64;
  // The tip to pay on top of the base fee.
  priority_fee_wei_per_gas : nat;
};
// A cached reading with the canister time it arrived at.
type ChainDataEntry = record { data : ChainData; pushed_at_ns : nat64 };
// Why a pushed reading is not one this canister prices gas with.
type ChainDataError = variant { FeeTooLarge : record { field : text } };
type Choice = variant { Requote; Refund };
// Every knob the canister reads at runtime. Numbers are the spec defaults; the two
// address maps and the key name are what a deploy fills in.
type Config = record {
  confirmations : vec record { nat64; nat64 };
  audit_chunk_events : nat32;
  rail_status_max_age_s : nat64;
  expiry_check_interval_s : nat64;
  batch_window_ms : nat64;
  max_refunds_per_sweep : nat32;
  ecdsa_key_name : text;
  max_fee_bps : nat16;
  // CCTP v2's `TokenMessengerV2`, the same address on every chain.
  token_messenger : opt text;
  rpc_urls : vec record { nat64; text };
  simulate_before_sign : bool;
  vault_addresses : vec record { nat64; text };
  // Whether the Eco rail may be used. False until its route is designed: a quote
  // naming it is refused at registration and at the claim, and a swap already on it is
  // paused until the rail is on again (counted by `paused_swaps`).
  eco_enabled : bool;
  platform_fee_bps : nat16;
  permit_deadline_s : nat64;
  // CCTP's domain id per chain: Circle's own numbering, never a chain id.
  cctp_domains : vec record { nat64; nat32 };
  // The minimum fee each chain's `TokenMessengerV2` holds a burn from it to, as Circle
  // stores it (`minFee()`, in thousandths of a basis point, below 10,000,000). A chain
  // with no entry is one whose messenger charges none. Every burn offers at least this
  // much of its amount as its `maxFee`, the Standard path included.
  cctp_min_fees : vec record { nat64; nat32 };
  replay_audit_interval_s : nat64;
  quote_ttl_s : nat64;
  // Eco's `Portal`, the same address on every chain.
  eco_portal : opt text;
  decision_timeout_min : nat64;
  // The USDC contract per chain, as an EVM address.
  usdc_addresses : vec record { nat64; text };
  chain_data_max_age_s : nat64;
  max_swap_usd : nat;
  max_batch_items : nat32;
  // How long after a quote's deposit deadline (its expiry plus the permit window) a
  // claim for a deposit that landed by that deadline is still admitted, from any
  // caller the claim admits, the controller included: 600 to 86,400 seconds, an hour by
  // default. The pending store keeps the quote until it ends.
  claim_grace_s : nat64;
  max_evictions_per_sweep : nat32;
  // CCTP v2's `MessageTransmitterV2`, the same address on every chain.
  message_transmitter : opt text;
  // How many blocks back from a chain's head the deposit read looks for a user's
  // deposit: at most 400,000, the widest range the read walks, forty windows of ten
  // thousand blocks, and the default; and more than a claim may be asked after its
  // deposit at four blocks a second (the longest quote, `permit_deadline_s` and
  // `claim_grace_s`), which `LookbackShorterThanClaims` refuses.
  deposit_lookback_blocks : nat32;
};
// Why a config was refused, naming the knob at fault.
type ConfigError = variant {
  // The canister has already derived its EVM address under the key name it holds, and
  // every vault on every chain is configured to obey that address.
  EcdsaKeyNameFixed : record { requested : text; current : text };
  EmptyEcdsaKeyName;
  // A claim may be asked `span_s` after the deposit it reads for (the longest quote
  // lifetime, `permit_deadline_s` and `claim_grace_s`), `needed_blocks` at four blocks a
  // second, and `deposit_lookback_blocks` does not reach that far back: a claim the door
  // admits would read past the deposit and leave it in the vault.
  LookbackShorterThanClaims : record {
    needed_blocks : nat64;
    span_s : nat64;
    lookback_blocks : nat32;
  };
  MaxFeeAboveHundredPercent : nat16;
  VaultAddressTooLong : record { len : nat64; chain_id : nat64 };
  CapOutOfRange : record { cap : nat32; field : text; ceiling : nat32 };
  TimerIntervalTooShort : record {
    field : text;
    interval_s : nat64;
    floor_s : nat64;
  };
  PlatformFeeAboveMax : record {
    max_fee_bps : nat16;
    platform_fee_bps : nat16;
  };
  EmptyVaultAddress : record { chain_id : nat64 };
  // The text in `field` (for a table, at `chain_id`) is not an EVM address.
  NotAnAddress : record {
    field : text;
    chain_id : opt nat64;
    reason : EvmAddressError;
  };
  // The depth configured for `chain_id` is below the floor a reorg on that chain makes
  // necessary, so a deposit or a receipt there could be taken as final and then leave
  // the chain.
  DepthTooShallow : record { floor : nat64; chain_id : nat64; depth : nat64 };
  RedactedRpcUrl : record { chain_id : nat64 };
  // In milliseconds, like the cap: the knob is below the least it may be.
  DurationBelowFloor : record {
    field : text;
    duration_ms : nat64;
    floor_ms : nat64;
  };
  TimerIntervalTooLong : record { field : text; interval_s : nat64 };
  // The minimum fee listed for `chain_id` is at or above `ceiling`, the whole amount in
  // Circle's units, which Circle's own setter refuses.
  CctpMinFeeTooHigh : record {
    ceiling : nat32;
    min_fee : nat32;
    chain_id : nat64;
  };
  // In milliseconds, so the one knob set in milliseconds is reported as it was set.
  DurationAboveCap : record {
    field : text;
    cap_ms : nat64;
    duration_ms : nat64;
  };
  AmountTooLarge : record { field : text };
  DurationTooLong : record { field : text };
  EmptyRpcUrl : record { chain_id : nat64 };
};
// Why a key or a signature is not one this canister can use. A refused management call is
// reported rather than trapped: the interface specification says a rejected signing
// request may leave the signature in the system anyway, so a caller that retries has to
// know it is retrying.
type EcdsaError = variant {
  NoParityRecovers;
  UnreadableSignature;
  UnreadablePublicKey;
  Signature : record { message : text };
  PublicKey : record { message : text };
};
// One entry of the log. `time_ns` is IC time in nanoseconds.
type Event = record {
  hash : blob;
  index : nat64;
  time_ns : nat64;
  payload : EventType;
  parent_hash : blob;
};
// What happened. The event hash is computed over a canonical encoding of the variant,
// never over this candid layout.
type EventType = variant {
  PocketFunded : record { chain_id : nat64; amount : nat };
  PaidInStable : record { quote_hash : blob; chain_id : nat64; amount : nat };
  // A gasless pull was signed: the transaction that takes a user's funds into the vault
  // with their permit, recorded before it is broadcast. It names the quote and the nonce
  // and no swap, because the deposit it makes is what `claim_swap` then verifies.
  PullSigned : record {
    quote_hash : blob;
    chain_id : nat64;
    nonce : nat64;
    raw_tx : blob;
    tx_hash : blob;
  };
  FundsReceived : record {
    token : text;
    quote_bytes : blob;
    quote_hash : blob;
    chain_id : nat64;
    tx_ref : text;
    amount : nat;
  };
  PocketReleased : record { quote_hash : blob; chain_id : nat64; amount : nat };
  Refunded : record {
    to : text;
    token : text;
    quote_hash : blob;
    chain_id : nat64;
    amount : nat;
  };
  TxSigned : record {
    attempt : nat32;
    quote_hash : blob;
    chain_id : nat64;
    raw_tx : blob;
    tx_hash : blob;
  };
  // A step of a flow: a gasless relay, ICP to EVM, or EVM to ICP. `step` names it,
  // `detail` is a readable rendering, and `step_bytes` is the step exactly as the log
  // hashes it.
  Flow : record {
    quote_hash : blob;
    step : text;
    detail : text;
    step_bytes : blob;
  };
  // A nonce that was allocated and never signed for was spent by a zero-value
  // self-transfer, so the chain is never left with a gap it cannot mine past.
  TxCancelled : record {
    chain_id : nat64;
    nonce : nat64;
    raw_tx : blob;
    tx_hash : blob;
  };
  SwapDone : record { quote_hash : blob };
  TxFailed : record { attempt : nat32; quote_hash : blob; reason : text };
  PocketRebalanced : record {
    to_chain : nat64;
    from_chain : nat64;
    amount : nat;
    route : text;
  };
  RefundStarted : record { quote_hash : blob; reason : text };
  DecisionRequired : record { quote_hash : blob; reason : text };
  // Principals as text, so the audit line reads without a decoder.
  RolesChanged : record { watcher : text; quoter : text };
  // A swap's waiting index entries were made to agree with the swap: what no event could
  // have produced was dropped, and the wait the swap is in is there. Only a divergence
  // needs one, so this line is the repair's explanation.
  WaitingRepaired : record { quote_hash : blob };
  FeeAccrued : record { quote_hash : blob; amount : nat };
  TxConfirmed : record {
    attempt : nat32;
    quote_hash : blob;
    chain_id : nat64;
    block : nat64;
    tx_hash : blob;
  };
  DecisionMade : record { quote_hash : blob; choice : Choice };
  // `json` is the public view of the config written: JSON of `Config` with every rpc url
  // as `"***"` and `max_swap_usd` as a decimal string.
  ConfigChanged : record { json : text };
  // A nonce was allocated to an outbound transaction, before the signature was asked
  // for. `to` is an EIP-55 address.
  TxCreated : record {
    to : text;
    max_priority_fee_wei_per_gas : nat;
    data : blob;
    max_fee_wei_per_gas : nat;
    chain_id : nat64;
    nonce : nat64;
    value_wei : nat;
    gas_limit : nat;
    purpose : TxPurpose;
  };
  Frozen : record { quote_hash : blob; reason : text };
  // An open transaction was re-sent at the same nonce with a higher fee, with the bytes
  // that were broadcast.
  TxReplaced : record {
    max_priority_fee_wei_per_gas : nat;
    max_fee_wei_per_gas : nat;
    chain_id : nat64;
    nonce : nat64;
    raw_tx : blob;
    tx_hash : blob;
    purpose : TxPurpose;
  };
  PocketReserved : record { quote_hash : blob; chain_id : nat64; amount : nat };
  PocketSpent : record { quote_hash : blob; chain_id : nat64; amount : nat };
};
// Why a text is not an EVM address. Mirrors `types::evm::EvmAddressError` so a caller
// replaying a log is told which of the four rules the text broke, rather than being told
// something that is false for three of them.
type EvmAddressError = variant {
  BadChecksum;
  WrongLength : record { len : nat64 };
  NoPrefix;
  NotHex;
};
// Where the ckUSDC of a registered EVM to ICP quote must be deposited.
type EvmQuoteRegistered = record {
  owner : principal;
  quote_hash : blob;
  subaccount : blob;
};
// The EVM to ICP quote the quoter registers before the router quote exists (spec 4b.8).
// `reference` is the router params' `ref`: the flow's key, and the subaccount of this
// canister the ckUSDC is deposited to.
type EvmToIcpQuote = record {
  min_out : nat;
  pool : opt principal;
  user : principal;
  reference : blob;
  target_ledger : principal;
  src_chain : nat64;
  nonce : nat64;
  expires_at_s : nat64;
};
// Why a flow door refused. Nothing moved.
type FlowCallError = variant {
  // The request is not one the canister acts on: the field and the reason.
  Invalid : text;
  Guard : GuardError;
  // A rule refused it: the reason.
  Refused : text;
  // A chain or a canister did not answer usably; the caller may try again.
  Unavailable : text;
};
// What the flows read at runtime. Set by a controller; the canister's `Config` is the
// chain layer's and stays as it was.
type FlowSettings = record {
  // The ckETH ledger, when the minter charges the withdrawal's gas in ckETH: the
  // canister approves the minter for `cketh_fee_allowance` of it before a withdrawal.
  cketh_ledger : opt principal;
  cketh_fee_allowance : nat;
  // The most gas a relay or a continuation may be given.
  max_gas_limit : nat64;
  // How long the continuation's params stay valid on chain.
  continuation_deadline_s : nat64;
  // The ckETH minter, which withdraws ckERC20 tokens too.
  ck_minter : opt principal;
  ckusdc_ledger : opt principal;
  // The furthest ahead a relayed quote's deadline may be.
  relay_window_s : nat64;
  // The only ICPSwap pools a quote may name.
  icpswap_pools : vec principal;
  // The SwapicRouter on each chain, as an EVM address.
  routers : vec record { nat64; text };
  // USDC on that chain, which the withdrawal lands as.
  ethereum_usdc : opt text;
  // The chain the ck minter withdraws to and the continuation runs on: Ethereum.
  ethereum_chain_id : nat64;
};
// A flow as the fold holds it.
type FlowView = record {
  status : text;
  tx_block : opt nat64;
  withdrawal_id : opt nat64;
  held : nat;
  kind : text;
  failed_continuations : nat32;
  chain_id : opt nat64;
  held_ledger : opt principal;
  delivered : opt nat;
  tx_hash : opt blob;
  tx_open : bool;
  continuation_action : opt nat8;
  landed_tx : opt blob;
  eth_held : nat;
  reason : opt text;
};
// Who pays the source-side gas. On the wire it is one byte, Gasless 0 and Legacy 1.
type GasMode = variant { Legacy; Gasless };
// Why a caller was refused before anything ran. A refusal names the role and never a
// principal.
type GuardError = variant {
  NotController;
  RolesNotSet;
  CallerNotRole : Role;
  CallerNotWatcherOrController;
  // Neither service principal, and not a controller either: the claim's door, which an
  // operator may open by hand.
  CallerNotQuoterWatcherOrController;
  CallerNotQuoterOrWatcher;
  Halted;
  RoleNotSet : Role;
};
// The ICP to EVM quote the quoter registers (spec 4b.1, 4b.7). `route` is the router
// params of the Ethereum continuation as one ABI tuple: its `rail`, `dstChainId`,
// `maxFee`, `minFinality`, `eco` and `dst` are the user's original destination terms,
// and the canister fills in itself as the payer of what lands.
type IcpToEvmQuote = record {
  pool : opt principal;
  user : principal;
  src_ledger : principal;
  nonce : nat64;
  amount_in : nat;
  expires_at_s : nat64;
  min_ckusdc : nat;
  route : blob;
};
// What an install starts from: the whole config and both service roles, so a canister is
// never live on default knobs or without its quoter and watcher. Each is validated as
// `set_config` and `set_roles` validate it, and anything invalid fails the install.
type InitArg = record {
  watcher : principal;
  config : Config;
  quoter : principal;
};
// The leg of a swap a transaction attempt was signed for.
type Leg = variant { Payout; Burn; Mint; Refund; Reclaim };
// How a swap's latest attempt ended.
type Outcome = variant { Failed; Confirmed };
// Why a pocket cannot make a move.
type PocketError = variant {
  Overflow;
  InsufficientReserved : record { requested : nat; "reserved" : nat };
  InsufficientAvailable : record { requested : nat; available : nat };
};
// Why `push_chain_data` stored nothing.
type PushChainDataError = variant {
  Guard : GuardError;
  InvalidData : ChainDataError;
};
// What the off-chain quoter handed the user, and the only thing the settlement canister
// ever hashes into a swap id. The hash is sha256 over a canonical preimage whose field
// order is frozen and is NOT the order a candid tool prints this record in:
// 
// `version u8 | src_chain u64-be | src_token (u32-be len + utf8) | amount_in u128-be |
// dst_chain u64 | dst_token | expected_out u128 | min_out u128 | dst_address |
// refund_address (None encodes as empty) | auto_refund u8 |
// gas_mode u8 (Gasless=0, Legacy=1) | rail | expires_at_s u64 | nonce u64`
// 
// Every integer is big-endian, every string is a u32-be byte length then utf8, and each
// of the two one-byte fields is 0 or 1. Amounts must fit in u128, text in 256 bytes, the
// two tokens and `dst_address` must not be empty, and the rail is one of `cctp_v2_fast`,
// `cctp_v2_standard`, `eco`. Reproduce those bytes and
// you reproduce the hash; `backend/libraries/types/golden/quote_hash_v1.txt` is the vector
// to check a reimplementation against.
type Quote = record {
  dst_address : text;
  // Where a refund is paid, and on an EVM source chain the paying wallet itself: the
  // quoter and the UI fill it with the connected wallet. A deposit counts only from this
  // address (`claim_swap` reads the vault's `Deposited` logs whose indexed payer is it),
  // a gasless pull's permit must be signed by it, and a deposit from any other wallet is
  // not the quote's deposit.
  refund_address : opt text;
  dst_chain : nat64;
  min_out : nat;
  rail : text;
  src_token : text;
  version : nat8;
  auto_refund : bool;
  src_chain : nat64;
  nonce : nat64;
  amount_in : nat;
  gas_mode : GasMode;
  expires_at_s : nat64;
  expected_out : nat;
  dst_token : text;
};
// Why a quote's field is not an EVM address: the field, and the way its text broke, or
// that the quote does not name it.
type QuoteAddressError = variant {
  // The field is the zero address, which the vault's `_send` reverts on: a payout or a
  // refund to it would freeze the swap after the funds had moved.
  Zero : record { field : QuoteAddressField };
  NotAnAddress : record { field : QuoteAddressField; reason : EvmAddressError };
  Absent : record { field : QuoteAddressField };
};
// The four fields of a quote that name an account or a token contract.
type QuoteAddressField = variant {
  DstAddress;
  SrcToken;
  DstToken;
  RefundAddress;
};
// Why a quote was refused, naming the field wherever one is at fault.
type QuoteError = variant {
  NotUtf8 : record { field : text };
  TextTooLong : record { len : nat64; field : text };
  EmptyRefundAddress;
  UnknownRail : text;
  NotABool : record { field : text; value : nat8 };
  NotAGasMode : nat8;
  UnsupportedVersion : nat8;
  EmptyText : record { field : text };
  TrailingBytes : record { len : nat64; consumed : nat64 };
  Truncated : record { at : nat64; len : nat64; field : text; wanted : nat64 };
  AmountTooLarge : record { field : text };
};
// Why a quote is not one its rail can carry: the rails carry the configured USDC on both
// sides and nothing else, compared as addresses. Addresses are EIP-55, the rail is its
// id.
type RailTokenError = variant {
  NotTheRailToken : record {
    field : QuoteAddressField;
    rail : text;
    rail_token : text;
    quoted : text;
  };
  QuoteAddress : QuoteAddressError;
  // The chain has no token configured for the rail.
  NoRailToken : record { rail : text; chain_id : nat64 };
};
// Why `register_quote` stored nothing.
type RegisterQuoteError = variant {
  // A token the quote names is not the one its rail carries, the USDC the deploy
  // configured for that chain: its claim would be refused on the same check, so the
  // quote is not handed to a user to pay.
  RailToken : RailTokenError;
  ExpiresTooFarAhead : record {
    now_s : nat64;
    expires_at_s : nat64;
    max_lifetime_s : nat64;
  };
  Guard : GuardError;
  StoreFull : record { capacity : nat64 };
  // The quote's destination address is not an address the destination chain can be
  // paid at: every chain this canister pays is an EVM chain, so not an EVM address.
  DstAddressNotAnAddress : record { reason : EvmAddressError };
  // A payee the quote names is one the vault cannot pay: the zero address as the
  // destination or the refund address.
  QuoteAddress : QuoteAddressError;
  // The quote names a rail this deploy does not run, by its id: its claim would be
  // refused, so the quote is not handed to a user to pay.
  RailUnavailable : record { rail : text };
  // The quote names no refund address, so no refund could ever be paid on it.
  NoRefundAddress;
  InvalidQuote : QuoteError;
  Expired : record { now_s : nat64; expires_at_s : nat64 };
  // The quote's refund address is not an EVM address.
  RefundAddressNotAnAddress : record { reason : EvmAddressError };
};
// A relay's status.
type RelayStatus = variant {
  Failed : record { chain_id : nat64; block : nat64; tx_hash : blob };
  Confirmed : record { chain_id : nat64; block : nat64; tx_hash : blob };
  // Signed and on its way; `tx_hash` is the first broadcast's.
  Signed : record { chain_id : nat64; tx_hash : blob };
};
// Why the log does not fold. The replay stopped at `index` and applied nothing from there.
type ReplayError = variant {
  OutOfSequence : record { found : nat64; expected : nat64 };
  LogFull : record { index : nat64 };
  Refused : record { error : TransitionError; index : nat64 };
  Unlinked : record { head : blob; index : nat64; parent : blob };
};
type Result = variant { Ok : AuditProgress; Err : GuardError };
type Result_1 = variant { Ok : nat64; Err : GuardError };
type Result_10 = variant { Ok; Err : FlowCallError };
type Result_11 = variant { Ok; Err : GuardError };
type Result_12 = variant { Ok; Err : SetRolesError };
type Result_13 = variant { Ok : nat64; Err : SetSanctionedError };
type Result_14 = variant { Ok : nat; Err : FlowCallError };
type Result_2 = variant { Ok : text; Err : SignError };
type Result_3 = variant { Ok : Config; Err : GuardError };
type Result_4 = variant { Ok : opt Quote; Err : GuardError };
type Result_5 = variant { Ok; Err : PushChainDataError };
type Result_6 = variant { Ok : EvmQuoteRegistered; Err : FlowCallError };
type Result_7 = variant { Ok : blob; Err : FlowCallError };
type Result_8 = variant { Ok : blob; Err : RegisterQuoteError };
type Result_9 = variant { Ok; Err : SetConfigError };
// A service role the canister hands out.
type Role = variant { Quoter; Watcher };
// Why `set_config` wrote nothing.
type SetConfigError = variant {
  InvalidConfig : ConfigError;
  Guard : GuardError;
  Append : AppendError;
};
// Why `set_roles` wrote nothing.
type SetRolesError = variant {
  Guard : GuardError;
  AnonymousRole : Role;
  Append : AppendError;
};
// Why `set_sanctioned` changed nothing.
type SetSanctionedError = variant {
  // The text at `index` of `list` (`"add"` or `"remove"`) is above the 256-byte cap.
  TextTooLong : record { len : nat64; list : text; index : nat64 };
  Guard : GuardError;
  // The set would grow past its cap; nothing of the call landed.
  SetFull : record { capacity : nat64 };
};
// Why a call that needs the canister's threshold key answered nothing.
type SignError = variant { Guard : GuardError; Ecdsa : EcdsaError };
// The folded state of one swap. `waiting_since_ns` is IC time in nanoseconds.
type Swap = record {
  status : SwapStatus;
  quote_bytes : blob;
  // The platform's fee on this swap, once the log has accrued it.
  fee_accrued : opt nat;
  src_token : text;
  // The most the swap's CCTP burn offered Circle, once one was created.
  burn_max_fee : opt nat;
  waiting_since_ns : opt nat64;
  // Absent until the swap is paid in stable.
  amount_paid : opt nat;
  // The transaction the latest attempt confirmed as, once it has.
  last_tx_hash : opt blob;
  src_chain : nat64;
  // What the payout leg was signed to pay the user, once one has been.
  paid_out : opt nat;
  // How the latest attempt ended: absent while it is open, or before any was signed.
  last_outcome : opt Outcome;
  amount_in : nat;
  open_attempt : opt nat32;
  // The leg the latest attempt was signed for, once one has been.
  last_leg : opt Leg;
  last_attempt : opt nat32;
};
// Where a swap is in its lifecycle. Plan 3 and the indexer read a swap's progress from it.
type SwapStatus = variant {
  PaidInStable;
  Refunding;
  WaitingForUser;
  FundsReceived;
  Delivering;
  Refunded;
  Done;
  Executing;
  Frozen;
};
// Why an event cannot move the state it was offered to.
type TransitionError = variant {
  NoUnsignedNonce : record { quote_hash : blob; chain_id : nat64 };
  // The line says the funds arrived on `logged`, and the quote it carries is for
  // `quoted`.
  FundsChainNotTheQuotes : record { logged : nat64; quoted : nat64 };
  CannotAskWhileRefunding;
  NonceNeverAllocated : record {
    next : nat64;
    chain_id : nat64;
    nonce : nat64;
  };
  WaitingForUser;
  NotRefunding : SwapStatus;
  Pocket : PocketError;
  // A flow step refused, with the domain's reason.
  Flow : text;
  SwapExists : blob;
  AttemptStillOpen : nat32;
  UnknownSwap : blob;
  NonceStillUnsigned : blob;
  NotExecuting : SwapStatus;
  NoOpenAttempt : blob;
  QuoteHashMismatch : record { computed : blob; declared : blob };
  UnparseableQuote : QuoteError;
  NonceOutOfSequence : record {
    expected : nat64;
    chain_id : nat64;
    nonce : nat64;
  };
  NonceExhausted : record { chain_id : nat64 };
  SwapClosed : SwapStatus;
  FeesOverflow;
  AttemptOutOfSequence : record { attempt : nat32; expected : opt nat32 };
  NonceNotUnsigned : record { chain_id : nat64; nonce : nat64 };
  AmountOutOfRange : nat;
  AttemptNotOpen : nat32;
  CannotStartRefund : SwapStatus;
  NotInFlight : SwapStatus;
  NotWaitingForUser : SwapStatus;
  // The swap already holds its platform fee: one fee line per swap.
  FeeAlreadyAccrued : blob;
  // The line says `logged` arrived, and the quote it carries is for `quoted`.
  FundsTokenNotTheQuotes : record { logged : text; quoted : text };
  // The line says `logged` arrived, and the quote it carries is for `quoted`.
  FundsAmountNotTheQuotes : record { logged : nat; quoted : nat };
  AlreadyPaid;
  UnknownPocket : nat64;
  NonceNotHeldForPull : record {
    quote_hash : blob;
    chain_id : nat64;
    nonce : nat64;
  };
};
// Why an outbound transaction exists. All but the last name the swap they belong to.
type TxPurpose = variant {
  Continue : blob;
  Payout : blob;
  Burn : blob;
  Mint : blob;
  Refund : blob;
  GaslessPull : blob;
  Relay : blob;
  Cancel : nat64;
  Reclaim : blob;
};
service : (InitArg) -> {
  // Controller-only. One step of the deep check: folds up to `max_events` more of the log
  // onto the fold the step before saved, from genesis when there is none, and once the fold
  // reaches the head compares it with the live state. An update, not a query, because a
  // divergence it finds halts the canister, and because the fold so far is saved in stable
  // memory between steps, so an audit spans as many calls as the log needs and survives an
  // upgrade in the middle.
  // 
  // Each step answers how much is folded and how much is left; keep calling until
  // `finished`. A refusal, a broken link, or a finished fold that differs from the live
  // state halts the canister, and every verdict starts the next audit over from genesis.
  // 
  // A step costs the entries it folds plus the fold so far, which is read and written whole,
  // so on a large fold the fold's own size is the floor and `max_events` is the rest. A step
  // too large for one message fails that call alone and leaves the saved fold where it was.
  audit_replay_step : (nat64) -> (Result);
  // Controller-only. Empties the pending store and answers how many quotes it held: the
  // store survives upgrades, so a store a compromised quoter filled is recovered here, in
  // place. Pre-money, so nothing is written to the log; the quoter re-registers what is live.
  clear_pending_quotes : () -> (Result_1);
  // Controller-only. Derives the canister's EVM address from its threshold key and caches
  // it, or answers the cached one. Deploy needs this before anything else: the vaults are
  // configured with this address and it has to be funded for gas, and neither can wait for
  // the first swap to derive it.
  derive_evm_address : () -> (Result_2);
  event_count : () -> (nat64) query;
  // `len` is capped server-side; ask for the count first and page through.
  events_page : (nat64, nat64) -> (vec Event) query;
  // The EVM address this canister signs from, in its EIP-55 checksum, or nothing before it
  // has been derived. World-readable: it is the address every vault on every chain is
  // configured to obey, and an operator funds it before the first transaction.
  // 
  // Derived once from the canister's threshold key and then read from stable memory, so it
  // is fixed for the life of the canister. `derive_evm_address` is the door that derives it.
  evm_address : () -> (opt text) query;
  // The cached reading for a chain, with the instant the canister stamped it, or nothing for
  // a chain the watcher has never pushed. World-readable: a block height and a gas price are
  // public facts about a public chain, and the stamp is how an operator sees the watcher
  // stop pushing.
  // 
  // Answers the entry however old it is. Freshness is a decision, and the canister makes it
  // against `chain_data_max_age` at the moment it decides.
  get_chain_data : (nat64) -> (opt ChainDataEntry) query;
  // Public, so it answers with the redacted view; `get_config_full` is the ops door onto
  // the real thing.
  get_config : () -> (Config) query;
  // The unredacted config, for ops. Controller-only, because `rpc_urls` holds api keys.
  get_config_full : () -> (Result_3) query;
  // A flow, any kind, as the fold holds it.
  get_flow : (blob) -> (opt FlowView) query;
  // The flows' settings.
  get_flow_settings : () -> (FlowSettings) query;
  // Quoter or watcher. Not public: a pending quote carries the user's destination and
  // refund addresses.
  get_pending : (blob) -> (Result_4) query;
  // The folded state of one swap. Public: every field of it is already in the
  // world-readable event log, `quote_bytes` included.
  get_swap : (blob) -> (opt Swap) query;
  // True once the canister has stopped on a divergence. Three things set it today: the audit
  // timer finding the fold out of step with the log, that same timer finding a bad link in
  // the chunk of the chain it verified, and a controller calling `set_halted`.
  // 
  // The deep comparison of the fold against a replay of the log is not on that timer: it is
  // the controller-only `audit_replay_step`, run as many times as the log needs, and it
  // halts the canister on what it finds. The flag also gates the expiry sweep, which appends
  // nothing while it is set; the money endpoints that honour it arrive with the chain layer.
  // 
  // Nothing clears it but a controller, once the divergence is understood.
  halted : () -> (bool) query;
  // Watcher-only. Ambient chain data: the head and the gas prices the watcher saw, which the
  // canister would otherwise spend an outcall on before every decision. It moves no money,
  // so the halt switch does not gate it: a halted canister still wants a current view of the
  // chains while an operator investigates.
  // 
  // The record carries no instant. The canister stamps what it stores with its own clock,
  // because the age of a reading is what every decision on it depends on, and a caller that
  // could date its data forward could keep stale gas prices alive indefinitely.
  push_chain_data : (nat64, ChainData) -> (Result_5);
  // Quoter-only, refused while halted. Registers an EVM to ICP quote durably BEFORE the
  // router quote is built (spec 4b.8): the user's principal is recorded with it, and the
  // answer names where the ckUSDC must be deposited, the canister's subaccount named by the
  // router params' `ref` (`reference`), so the route's helper deposit carries it. The
  // engine finds the ckUSDC there, swaps it on ICPSwap and pays the user. A quote for
  // ckUSDC itself names no pool, and its ckUSDC is forwarded as it is.
  register_evm_quote : (EvmToIcpQuote) -> (Result_6);
  // Quoter-only, refused while halted. Registers an ICP to EVM quote durably, with the
  // user's original destination terms (its route), BEFORE the user is told what to
  // approve (spec 4b.1). Answers the quote hash: the user approves the canister with that
  // hash as the spender subaccount, and only that allowance is ever pulled.
  register_icp_quote : (IcpToEvmQuote) -> (Result_7);
  // Quoter-only, for a quote of either gas mode. Records a quote the quoter handed a user,
  // so the funds that arrive later can be matched to it, and returns the hash the deposit
  // must carry. Pre-money, so nothing is written to the log. Refuses what a claim would
  // refuse by the quote alone: a rail the deploy has off, a payee that is no address or the
  // zero address, and a token on either side that is not the USDC the deploy configured for
  // that chain (`RailToken`), which the claim refuses on the same config. Halted, the
  // canister registers nothing: no new swaps during a halt. A full store first drops quotes
  // whose claim's grace has ended. The quote's deposit and claim deadlines are fixed here,
  // from the permit window and the grace the config holds now, and a later config change
  // moves neither.
  register_quote : (Quote) -> (Result_8);
  // Quoter-only, refused while halted. Relays a user's signed `swapFor` through the router
  // on `chain_id`: `params` and `auth` are the ABI encodings of the `SwapParams` and
  // `GaslessAuth` tuples. The quote hash is recomputed from the params as the router does,
  // every readable field is checked against them, the authorization must recover to the
  // payer, and `swapFor` must succeed in simulation before the canister signs it once and
  // records `GaslessRelayed`. Answers the quote hash; `relay_status` follows it.
  relay_gasless : (nat64, blob, blob) -> (Result_7);
  // A gasless relay's status: signed, then confirmed or failed at depth.
  relay_status : (blob) -> (opt RelayStatus) query;
  // Controller-only, and it takes the whole record, so editing one knob is a
  // read-modify-write: read with `get_config_full`, never with the redacted `get_config`,
  // or the write puts "***" into `rpc_urls` and is refused.
  set_config : (Config) -> (Result_9);
  // Controller-only. The routers, the ck canisters, the ICPSwap pools a quote may name,
  // and the windows the flows read.
  set_flow_settings : (FlowSettings) -> (Result_10);
  // Controller-only, both ways: `true` is an emergency stop, `false` is the human saying
  // the divergence has been investigated. The audit never clears it on its own.
  // 
  // Lifting the halt wakes the outbox: a halted canister's pass does not re-arm itself,
  // so this is what puts it back on the window when a queued transaction or an allocation
  // waiting for its cancel was held back by the halt.
  set_halted : (bool) -> (Result_11);
  // Controller-only, and it sets both roles at once: a deploy hands out the pair, and
  // there is no path that leaves one of them stale.
  set_roles : (principal, principal) -> (Result_12);
  // The watcher's, or a controller's. Adds `add` to the sanctions set and then removes
  // `remove` from it, and answers how many addresses the set holds after. An EVM address is
  // held by its bytes, so any spelling of it is the same entry; other text is held exactly.
  // Compliance data, not money, so the halt switch does not gate it: an operator halting on
  // a divergence still wants the list current.
  // 
  // The set is bounded, and a call that would take it past the bound is refused whole, with
  // nothing of it written. Every text is held to the 256-byte cap and a longer one is refused
  // by its position, also with nothing written.
  set_sanctioned : (vec text, vec text) -> (Result_13);
  // Quoter-only, refused while halted. Starts a registered ICP to EVM quote: pulls the
  // user's token with `icrc2_transfer_from` from the allowance whose spender subaccount is
  // the quote hash (and from no other), and answers what was pulled. The engine then swaps
  // on ICPSwap when needed, withdraws through the ck minter to the canister's own Ethereum
  // address, and continues on Ethereum once the USDC lands.
  start_icp_swap : (blob) -> (Result_14);
  verify_chain : () -> (bool) query;
  verify_replay : () -> (bool) query;
  version : () -> (text) query;
}
