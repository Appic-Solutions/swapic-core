type Choice = variant { Requote; Refund };
// Every knob the canister reads at runtime. Numbers are the spec defaults; the two
// address maps and the key name are what a deploy fills in.
type Config = record {
  confirmations : vec record { nat64; nat64 };
  rail_status_max_age_s : nat64;
  expiry_check_interval_s : nat64;
  batch_window_ms : nat64;
  ecdsa_key_name : text;
  max_fee_bps : nat16;
  rpc_urls : vec record { nat64; text };
  simulate_before_sign : bool;
  vault_addresses : vec record { nat64; text };
  platform_fee_bps : nat16;
  permit_deadline_s : nat64;
  replay_audit_interval_s : nat64;
  quote_ttl_s : nat64;
  decision_timeout_min : nat64;
  chain_data_max_age_s : nat64;
  max_swap_usd : nat;
  max_batch_items : nat32;
};
// One entry of the log. `time_ns` is IC time in nanoseconds.
type Event = record {
  hash : blob;
  index : nat64;
  time_ns : nat64;
  payload : EventType;
  parent_hash : blob;
};
// What happened. The event hash is computed over a canonical encoding of the variant,
// never over this candid layout.
type EventType = variant {
  PocketFunded : record { chain_id : nat64; amount : nat };
  PaidInStable : record { quote_hash : blob; chain_id : nat64; amount : nat };
  FundsReceived : record {
    token : text;
    quote_bytes : blob;
    quote_hash : blob;
    chain_id : nat64;
    tx_ref : text;
    amount : nat;
  };
  PocketReleased : record { quote_hash : blob; chain_id : nat64; amount : nat };
  Refunded : record {
    to : text;
    token : text;
    quote_hash : blob;
    chain_id : nat64;
    amount : nat;
  };
  TxSigned : record {
    attempt : nat32;
    quote_hash : blob;
    chain_id : nat64;
    raw_tx : blob;
    tx_hash : blob;
  };
  SwapDone : record { quote_hash : blob };
  TxFailed : record { attempt : nat32; quote_hash : blob; reason : text };
  PocketRebalanced : record {
    to_chain : nat64;
    from_chain : nat64;
    amount : nat;
    route : text;
  };
  RefundStarted : record { quote_hash : blob; reason : text };
  DecisionRequired : record { quote_hash : blob; reason : text };
  // Principals as text, so the audit line reads without a decoder.
  RolesChanged : record { watcher : text; quoter : text };
  FeeAccrued : record { quote_hash : blob; amount : nat };
  TxConfirmed : record {
    attempt : nat32;
    quote_hash : blob;
    chain_id : nat64;
    block : nat64;
    tx_hash : blob;
  };
  DecisionMade : record { quote_hash : blob; choice : Choice };
  ConfigChanged : record { json : text };
  Frozen : record { quote_hash : blob; reason : text };
  PocketReserved : record { quote_hash : blob; chain_id : nat64; amount : nat };
  PocketSpent : record { quote_hash : blob; chain_id : nat64; amount : nat };
};
// Who pays the source-side gas. On the wire it is one byte, Gasless 0 and Legacy 1.
type GasMode = variant { Legacy; Gasless };
// What the off-chain quoter handed the user, and the only thing the settlement canister
// ever hashes into a swap id. The hash is sha256 over a canonical preimage whose field
// order is frozen and is NOT the order a candid tool prints this record in:
// 
// `version u8 | src_chain u64-be | src_token (u32-be len + utf8) | amount_in u128-be |
// dst_chain u64 | dst_token | expected_out u128 | min_out u128 | dst_address |
// refund_address (None encodes as empty) | auto_refund u8 |
// gas_mode u8 (Gasless=0, Legacy=1) | rail | expires_at_s u64 | nonce u64`
// 
// Every integer is big-endian, every string is a u32-be byte length then utf8, and each
// of the two one-byte fields is 0 or 1. Amounts must fit in u128, text in 256 bytes, and
// the rail is one of `cctp_v2_fast`, `cctp_v2_standard`, `eco`. Reproduce those bytes and
// you reproduce the hash; `backend/libraries/types/golden/quote_hash_v1.txt` is the vector
// to check a reimplementation against.
type Quote = record {
  dst_address : text;
  refund_address : opt text;
  dst_chain : nat64;
  min_out : nat;
  rail : text;
  src_token : text;
  version : nat8;
  auto_refund : bool;
  src_chain : nat64;
  nonce : nat64;
  amount_in : nat;
  gas_mode : GasMode;
  expires_at_s : nat64;
  expected_out : nat;
  dst_token : text;
};
type Result = variant { Ok : Config; Err : text };
type Result_1 = variant { Ok : opt Quote; Err : text };
type Result_2 = variant { Ok : blob; Err : text };
type Result_3 = variant { Ok; Err : text };
// The folded state of one swap. `waiting_since_ns` is IC time in nanoseconds.
type Swap = record {
  status : SwapStatus;
  quote_bytes : blob;
  src_token : text;
  waiting_since_ns : opt nat64;
  amount_paid : nat;
  src_chain : nat64;
  amount_in : nat;
  open_attempt : opt nat32;
  last_attempt : opt nat32;
};
// Where a swap is in its lifecycle. Plan 3 and the indexer read a swap's progress from it.
type SwapStatus = variant {
  PaidInStable;
  Refunding;
  WaitingForUser;
  FundsReceived;
  Delivering;
  Refunded;
  Done;
  Executing;
  Frozen;
};
service : () -> {
  event_count : () -> (nat64) query;
  // `len` is capped server-side; ask for the count first and page through.
  events_page : (nat64, nat64) -> (vec Event) query;
  // Public, so it answers with the redacted view; `get_config_full` is the ops door onto
  // the real thing.
  get_config : () -> (Config) query;
  // The unredacted config, for ops. Controller-only, because `rpc_urls` holds api keys.
  get_config_full : () -> (Result) query;
  // Quoter or watcher. Not public: a pending quote carries the user's destination and
  // refund addresses.
  get_pending : (blob) -> (Result_1) query;
  // The folded state of one swap. Public: every field of it is already in the
  // world-readable event log, `quote_bytes` included.
  get_swap : (blob) -> (opt Swap) query;
  // True once a replay audit has found the log and the live state disagree. Nothing clears
  // it but a controller, and money endpoints refuse while it is set.
  halted : () -> (bool) query;
  // Quoter-only, and it takes a quote of either gas mode. Pre-money: it records a quote
  // the quoter has just handed a user so the funds that arrive later can be matched to it,
  // and returns the hash the user's deposit must carry. Nothing of value moves here, so
  // nothing is written to the log.
  register_quote : (Quote) -> (Result_2);
  // Controller-only, and it takes the whole record, so editing one knob is a
  // read-modify-write: read with `get_config_full`, never with the redacted `get_config`,
  // or the write puts "***" into `rpc_urls` and the canister loses its rpc access.
  set_config : (Config) -> (Result_3);
  // Controller-only, both ways: `true` is an emergency stop, `false` is the human saying
  // the divergence has been investigated. The audit never clears it on its own.
  set_halted : (bool) -> (Result_3);
  // Controller-only, and it sets both roles at once: a deploy hands out the pair, and
  // there is no path that leaves one of them stale.
  set_roles : (principal, principal) -> (Result_3);
  verify_chain : () -> (bool) query;
  verify_replay : () -> (bool) query;
  version : () -> (text) query;
}
